# Copy to local.properties (not committed) and edit. Rebuild after changing.

# Android SDK location (Android Studio writes this for you)
sdk.dir=/home/you/Android/Sdk

# mock (default) or real
birdeye.api=mock

# Required when birdeye.api=real. Laptop address; cleartext HTTP works in debug builds only.
birdeye.baseUrl=http://192.168.1.10:8000

# Camera height above the road in metres, measured in the mount. Default 1.0 with a warning.
birdeye.cameraHeightM=1.2

# Optional. Default eagle-dev.
birdeye.deviceId=car-01
