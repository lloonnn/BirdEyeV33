# Template for dashboard/.env.local. Copy this file to .env.local and fill in
# the key. .env.local is ignored by git; never commit a real key.
# Restart `npm run dev` after any change: NEXT_PUBLIC_ values are read at build time.

# CARTO basemap key for the dark map tiles (decision 81).
# Free at https://carto.com/basemaps/apikey, or ask the team for the shared key.
NEXT_PUBLIC_CARTO_KEY=

# mock = invented data (default). real = call the backend below.
NEXT_PUBLIC_API_MODE=mock

# Backend address for real mode (decision 80).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Action code: one code the team shares to unlock actions (verify, approve,
# answers, reset). Server only: never rename it with NEXT_PUBLIC_. Set it here
# in .env.local for local work, and in the host's environment settings for a
# deployment. Left empty, every action stays off. A speed bump, not security.
ACTION_CODE=
