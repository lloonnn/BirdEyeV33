# Manual route only. Copy this file to .env.local and edit it. .env.local is ignored by git.
# Docker does not read this file. The Docker route takes these values from backend/.env.
# Restart `npm run dev` after any change: NEXT_PUBLIC_ values are read at build time.

# Optional. CARTO basemap key for the dark map tiles (decision 81).
# Without it the map tiles show an "API key required" watermark.
# Get a free key at https://carto.com/basemaps/apikey, or ask the team for the shared key.
NEXT_PUBLIC_CARTO_KEY=

# Required. mock = invented data in the browser, no backend needed.
# real = call the backend below. Use real when the backend is running.
NEXT_PUBLIC_API_MODE=mock

# Required when NEXT_PUBLIC_API_MODE=real (decision 80). The address of the backend.
# Use the default when the backend runs on this laptop.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. The code that unlocks actions (verify, approve, answers, reset).
# Server only: never rename it with NEXT_PUBLIC_. Left empty, every action stays off.
# Pick any word, for example demo. A speed bump, not security.
ACTION_CODE=
