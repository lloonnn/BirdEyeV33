# Copy to backend/.env and edit. backend/.env is never committed.
# Thresholds marked "starting value, to be tuned" in bird_eye/settings.py.
BIRDEYE_DATABASE_URL=postgresql+psycopg://birdeye:birdeye@localhost:5432/birdeye
BIRDEYE_TEST_DATABASE_URL=postgresql+psycopg://birdeye:birdeye@localhost:5432/birdeye_test
BIRDEYE_CORS_ORIGINS=["http://localhost:3000"]
BIRDEYE_CROP_DIR=./data/crops
BIRDEYE_CROP_URL_PREFIX=/crops
BIRDEYE_LOCAL_TIMEZONE=Asia/Kuala_Lumpur
BIRDEYE_MAX_CROP_BYTES=200000
BIRDEYE_MAX_RECORDS_PER_BATCH=200
BIRDEYE_MAX_FUTURE_SKEW_MINUTES=5
BIRDEYE_DEFECTS_LIMIT_DEFAULT=500
BIRDEYE_DEFECTS_LIMIT_MAX=1000
BIRDEYE_TYPE_TERM_POTHOLE=1.0
BIRDEYE_TYPE_TERM_CRACK=0.5
BIRDEYE_AGE_FULL_DAYS=30
BIRDEYE_WEIGHT_TYPE=0.25
BIRDEYE_WEIGHT_SIZE=0.25
BIRDEYE_WEIGHT_LOCATION=0.25
BIRDEYE_WEIGHT_AGE=0.25
BIRDEYE_BAND_HIGH_MIN=0.66
BIRDEYE_BAND_MEDIUM_MIN=0.33
